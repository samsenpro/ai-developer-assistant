# Copia este archivo como .env y ajusta los valores. .env está en .gitignore: nunca se sube.

# --- Obligatorias ---
# Contraseña de PostgreSQL
DB_PASSWORD=change-me
# Clave HMAC para firmar los JWT (mínimo 32 caracteres). Genera una con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# --- Proveedor LLM (API compatible con OpenAI) ---
# Opción A: Ollama local (docker compose --profile ollama up --build). Son los valores por defecto:
AI_PROVIDER_NAME=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen2.5-coder:3b
AI_API_KEY=not-needed-for-ollama
AI_TIMEOUT=180s

# Opción B: OpenAI (o cualquier API compatible: Groq, OpenRouter, DeepSeek...)
# AI_PROVIDER_NAME=openai
# AI_BASE_URL=https://api.openai.com
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...
# AI_TIMEOUT=60s

# Pedir response_format=json_object (desactivar si el proveedor no lo soporta)
AI_JSON_MODE=true

# --- Límites y caché (opcionales) ---
AI_DAILY_TOKENS_PER_USER=200000
AI_DAILY_REQUESTS_PER_USER=300
AI_CACHE_TTL=7d
FILE_MAX_SIZE=100KB

# --- Otros (opcionales) ---
# Puerto de la API en el host
APP_PORT=8095
# Swagger UI y /v3/api-docs (false en producción si el contrato no debe ser público)
API_DOCS_ENABLED=true
